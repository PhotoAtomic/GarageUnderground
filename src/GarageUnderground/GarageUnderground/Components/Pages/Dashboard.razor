@page "/dashboard"
@using GarageUnderground.Authentication.Client
@using GarageUnderground.Models
@using GarageUnderground.Services.Client
@inject ApiAuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject IInterventiService InterventiService
@inject IAutoService AutoService
@rendermode InteractiveServer
@implements IDisposable

<PageTitle>Dashboard - GarageUnderground</PageTitle>

@if (isLoading)
{
    <div class="loading-container">
        <div class="loading-spinner"></div>
    </div>
}
else if (user?.IsAuthenticated == true)
{
    <section class="dashboard">
        @if (!string.IsNullOrEmpty(toast))
        {
            <div class="toast" role="status">
                <svg class="icon-small" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                    <polyline points="20 6 9 17 4 12"/>
                </svg>
                <span>@toast</span>
            </div>
        }

        <div class="search-section">
            <div class="search-container">
                <input type="text" 
                       class="search-input" 
                       placeholder="Targa, proprietario o modello..."
                       @bind="searchTarga"
                       @bind:event="oninput"
                       @bind:after="OnSearchInputChanged"
                       @onkeydown="HandleSearchKeyDown" />
                @if (showSearchButton)
                {
                    <button class="btn btn-search" @onclick="AvviaRicerca" disabled="@isSearching">
                        @if (isSearching)
                        {
                            <span class="btn-spinner"></span>
                        }
                        else
                        {
                            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="11" cy="11" r="8"/>
                                <path d="m21 21-4.35-4.35"/>
                            </svg>
                            <span>Cerca</span>
                        }
                    </button>
                }
            </div>
        </div>

        @if (!hasSearched)
        {
            var suggerimenti = Suggerimenti.ToList();
            if (suggerimenti.Count > 0 || riepilogoTarghe.Count > 0)
            {
                <div class="targhe-section">
                    <div class="targhe-header">
                        <h2 class="targhe-title">@TitoloTarghe</h2>
                        <div class="targhe-filtro" role="group" aria-label="Filtro targhe">
                            <button type="button" class="filtro-btn @(filtroTarghe == FiltroTarghe.Recenti ? "attivo" : "")"
                                    @onclick="() => filtroTarghe = FiltroTarghe.Recenti">Ultimi interventi</button>
                            <button type="button" class="filtro-btn @(filtroTarghe == FiltroTarghe.NonPagati ? "attivo" : "")"
                                    @onclick="() => filtroTarghe = FiltroTarghe.NonPagati">Non pagati</button>
                        </div>
                    </div>
                    @if (filtroTarghe == FiltroTarghe.NonPagati && suggerimenti.Count > 0)
                    {
                        <div class="targhe-totale">
                            <span class="targhe-totale-label">Totale da incassare</span>
                            <span class="targhe-totale-value">&euro; @suggerimenti.Sum(v => v.Riepilogo?.TotaleDaPagare ?? 0).ToString("N2")</span>
                            <span class="targhe-totale-info">@suggerimenti.Count @(suggerimenti.Count == 1 ? "targa" : "targhe")</span>
                        </div>
                    }
                    @if (suggerimenti.Count > 0)
                    {
                        <div class="targhe-list">
                            @foreach (var v in suggerimenti)
                            {
                                @RenderChip(v)
                            }
                        </div>
                    }
                    else
                    {
                        <p class="targhe-vuoto">@(filtroTarghe == FiltroTarghe.NonPagati ? "Nessun intervento da incassare." : "Nessuna targa trovata.")</p>
                    }
                </div>
            }
        }
        else
        {
            <div class="interventi-section">
                @if (auto is not null)
                {
                    <div class="auto-card">
                        <div class="auto-header">
                            <div class="auto-title">
                                <span class="auto-targa">@auto.Targa</span>
                                @if (!string.IsNullOrEmpty(auto.Descrizione))
                                {
                                    <span class="auto-modello">@auto.Descrizione</span>
                                }
                            </div>
                            <button class="btn-edit" @onclick="NavigateToEditAuto" title="Modifica scheda auto">
                                <svg class="icon-edit" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                </svg>
                            </button>
                        </div>
                        <dl class="auto-details">
                            @if (!string.IsNullOrEmpty(auto.Proprietario))
                            {
                                <div class="auto-detail">
                                    <dt>Proprietario</dt>
                                    <dd>
                                        @auto.Proprietario
                                        @if (!string.IsNullOrEmpty(auto.Telefono))
                                        {
                                            <a class="auto-telefono" href="tel:@auto.Telefono">@auto.Telefono</a>
                                        }
                                    </dd>
                                </div>
                            }
                            @if (auto.Anno is not null)
                            {
                                <div class="auto-detail"><dt>Anno</dt><dd>@auto.Anno</dd></div>
                            }
                            @if (!string.IsNullOrEmpty(auto.Colore))
                            {
                                <div class="auto-detail"><dt>Colore</dt><dd>@auto.Colore</dd></div>
                            }
                            @if (auto.Cilindrata is not null)
                            {
                                <div class="auto-detail"><dt>Cilindrata</dt><dd>@auto.Cilindrata cc</dd></div>
                            }
                            @if (!string.IsNullOrEmpty(auto.Alimentazione))
                            {
                                <div class="auto-detail"><dt>Alimentazione</dt><dd>@auto.Alimentazione</dd></div>
                            }
                            @if (!string.IsNullOrEmpty(auto.Note))
                            {
                                <div class="auto-detail auto-note"><dt>Note</dt><dd>@auto.Note</dd></div>
                            }
                        </dl>
                    </div>
                }
                else
                {
                    <div class="nuova-auto-card" @onclick="NavigateToNuovaAuto">
                        <span class="plus-icon plus-icon-auto">+</span>
                        <span class="nuovo-intervento-text">Aggiungi Auto</span>
                    </div>
                }

                @if (interventi.Count > 0)
                {
                    <div class="riepilogo-card">
                        <div class="riepilogo-item">
                            <span class="riepilogo-label">Interventi</span>
                            <span class="riepilogo-value">@interventi.Count</span>
                        </div>
                        <div class="riepilogo-item">
                            <span class="riepilogo-label">Totale</span>
                            <span class="riepilogo-value">&euro; @TotaleCosto.ToString("N2")</span>
                        </div>
                        <div class="riepilogo-item @(TotaleDaPagare > 0 ? "da-incassare" : "")">
                            <span class="riepilogo-label">Da incassare</span>
                            <span class="riepilogo-value">&euro; @TotaleDaPagare.ToString("N2")</span>
                        </div>
                    </div>
                }

                <div class="nuovo-intervento-card" @onclick="NavigateToNuovoIntervento">
                    <span class="plus-icon">+</span>
                    <span class="nuovo-intervento-text">Nuovo Intervento</span>
                </div>

                @if (interventi.Count == 0)
                {
                    <div class="no-results">
                        <p>Nessun intervento trovato per la targa <strong>@currentTarga</strong></p>
                        @{
                            var simili = Suggerimenti.Where(v => v.Targa != currentTarga).ToList();
                        }
                        @if (simili.Count > 0)
                        {
                            <p class="no-results-hint">Forse cercavi:</p>
                            <div class="targhe-list">
                                @foreach (var v in simili)
                                {
                                    @RenderChip(v)
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="interventi-list">
                        @foreach (var intervento in interventi)
                        {
                            <div class="intervento-card @(intervento.Pagato ? "pagato" : "non-pagato")">
                                <div class="intervento-header">
                                    <span class="intervento-data">@intervento.Data.ToString("dd/MM/yyyy")</span>
                                    <div class="intervento-header-right">
                                        <button class="btn-edit" @onclick="() => NavigateToEditIntervento(intervento.Id)" title="Modifica intervento">
                                            <svg class="icon-edit" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                                            </svg>
                                        </button>
                                    </div>
                                </div>
                                <p class="intervento-descrizione">@intervento.Descrizione</p>
                                <div class="intervento-footer">
                                    <button class="intervento-stato @(intervento.Pagato ? "stato-pagato" : "stato-non-pagato")"
                                            @onclick="() => TogglePagato(intervento)"
                                            disabled="@(togglingId == intervento.Id)"
                                            title="@(intervento.Pagato ? "Segna come da pagare" : "Segna come pagato")">
                                        @if (togglingId == intervento.Id)
                                        {
                                            <span class="btn-spinner btn-spinner-small"></span>
                                        }
                                        else if (intervento.Pagato)
                                        {
                                            <svg class="icon-small" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                                                <polyline points="20 6 9 17 4 12"/>
                                            </svg>
                                        }
                                        else
                                        {
                                            <svg class="icon-small" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                                                <circle cx="12" cy="12" r="10"/>
                                                <line x1="12" y1="8" x2="12" y2="12"/>
                                                <line x1="12" y1="16" x2="12.01" y2="16"/>
                                            </svg>
                                        }
                                        <span>@(intervento.Pagato ? "Pagato" : "Da pagare")</span>
                                    </button>
                                    <span class="intervento-costo">&euro; @intervento.Costo.ToString("N2")</span>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </section>
}

@code {
    [SupplyParameterFromQuery]
    public string? Targa { get; set; }

    /// <summary>
    /// Esito dell'operazione appena conclusa in un'altra pagina, mostrato come conferma.
    /// </summary>
    [SupplyParameterFromQuery]
    public string? Esito { get; set; }

    private const int MaxSuggerimenti = 10;
    // Tutte le targhe: il filtro "Non pagati" deve vederle tutte, non solo le più recenti
    private const int MaxTargheInArchivio = int.MaxValue;

    private enum FiltroTarghe { Recenti, NonPagati }
    private static readonly TimeSpan ToastDuration = TimeSpan.FromSeconds(3);

    private UserInfo? user;
    private bool isLoading = true;
    private bool isSearching = false;
    private bool hasSearched = false;
    private bool showSearchButton = true;
    private string searchTarga = string.Empty;
    private string currentTarga = string.Empty;
    private List<InterventoDto> interventi = [];
    private AutoDto? auto;
    private List<TargaRiepilogo> riepilogoTarghe = [];
    private List<AutoDto> autoArchivio = [];
    private FiltroTarghe filtroTarghe = FiltroTarghe.Recenti;
    // Ultima targa letta dall'URL: serve a capire se un cambio di parametri è una vera navigazione
    private string? lastTargaParam;
    private Guid? togglingId;

    private string? TargaDaUrl => string.IsNullOrWhiteSpace(Targa) ? null : TargaNormalizer.Normalize(Targa);
    private string? toast;
    private CancellationTokenSource? toastCts;

    private decimal TotaleCosto => interventi.Sum(i => i.Costo);
    private decimal TotaleDaPagare => interventi.Where(i => !i.Pagato).Sum(i => i.Costo);

    private string TitoloTarghe => filtroTarghe switch
    {
        FiltroTarghe.NonPagati => "Da incassare",
        _ => string.IsNullOrWhiteSpace(searchTarga) ? "Targhe recenti" : "Targhe in archivio"
    };

    /// <summary>
    /// Voci dell'archivio che rispondono a quello che si sta digitando — per targa, proprietario
    /// o marca/modello (tutte, se il campo è vuoto). Con "Ultimi interventi" sono le più recenti,
    /// al massimo <see cref="MaxSuggerimenti"/>; con "Non pagati" tutte quelle con qualcosa da
    /// incassare, senza limite.
    /// </summary>
    private IEnumerable<VoceArchivio> Suggerimenti
    {
        get
        {
            var voci = RicercaArchivio.Cerca(riepilogoTarghe, autoArchivio, searchTarga);
            return filtroTarghe == FiltroTarghe.NonPagati
                ? voci.Where(v => v.Riepilogo?.TotaleDaPagare > 0)
                : voci.Take(MaxSuggerimenti);
        }
    }

    /// <summary>
    /// Scheda di una voce nei suggerimenti: targa, interventi, e se c'è l'anagrafica
    /// proprietario · marca modello · cilindrata, con in evidenza il campo che ha risposto alla ricerca.
    /// </summary>
    private RenderFragment RenderChip(VoceArchivio v) => __builder =>
    {
        <button class="targa-chip" @onclick="() => SelectTarga(v.Targa)">
            <span class="targa-chip-targa @(v.Corrispondenza == CampoCorrispondenza.Targa ? "match" : "")">@v.Targa</span>
            @if (v.Riepilogo is { } r)
            {
                <span class="targa-chip-info">@r.NumeroInterventi @(r.NumeroInterventi == 1 ? "intervento" : "interventi") &middot; @r.UltimaData.ToString("dd/MM/yyyy")</span>
            }
            else
            {
                <span class="targa-chip-info">Nessun intervento</span>
            }
            @if (v.Auto is { } a && (!string.IsNullOrEmpty(a.Proprietario) || !string.IsNullOrEmpty(a.Descrizione) || a.Cilindrata is not null))
            {
                <span class="targa-chip-auto">
                    @if (!string.IsNullOrEmpty(a.Proprietario))
                    {
                        <span class="@(v.Corrispondenza == CampoCorrispondenza.Proprietario ? "match" : "")">@a.Proprietario</span>
                    }
                    @if (!string.IsNullOrEmpty(a.Descrizione))
                    {
                        <span class="@(v.Corrispondenza == CampoCorrispondenza.Modello ? "match" : "")">@a.Descrizione</span>
                    }
                    @if (a.Cilindrata is not null)
                    {
                        <span>@a.Cilindrata cc</span>
                    }
                </span>
            }
            @if (v.Riepilogo?.TotaleDaPagare > 0)
            {
                <span class="targa-chip-debito">&euro; @v.Riepilogo.TotaleDaPagare.ToString("N2") da incassare</span>
            }
        </button>
    };

    protected override async Task OnInitializedAsync()
    {
        user = await AuthStateProvider.GetCurrentUserAsync(forceRefresh: true);

        if (user?.IsAuthenticated != true)
        {
            Navigation.NavigateTo("/");
            return;
        }

        // Check if user has canLogin role
        var hasLoginRole = user.Roles?.Any(r => r.Equals("canLogin", StringComparison.OrdinalIgnoreCase)) == true;
        if (!hasLoginRole)
        {
            Navigation.NavigateTo("/access-denied");
            return;
        }

        var riepilogoTask = InterventiService.GetRiepilogoTargheAsync(MaxTargheInArchivio);
        var autoTask = AutoService.GetAllAsync();

        // Se c'è una targa nel query parameter, esegui automaticamente la ricerca
        lastTargaParam = TargaDaUrl;
        if (lastTargaParam is not null)
        {
            searchTarga = lastTargaParam;
            isLoading = false;
            await SearchInterventi();
        }
        else
        {
            isLoading = false;
        }

        riepilogoTarghe = (await riepilogoTask).ToList();
        autoArchivio = (await autoTask).ToList();

        var messaggio = Esito switch
        {
            "salvato" => "Intervento salvato",
            "eliminato" => "Intervento eliminato",
            "auto-salvata" => "Scheda auto salvata",
            "auto-eliminata" => "Scheda auto eliminata",
            _ => null
        };
        if (messaggio is not null)
        {
            _ = ShowToastAsync(messaggio);
        }
    }

    private void SelectTarga(string targa)
    {
        searchTarga = targa;
        Navigation.NavigateTo(UrlTarga(TargaNormalizer.Normalize(targa)));
    }

    /// <summary>
    /// Ogni targa aperta è una voce di cronologia (<c>?targa=…</c>). Quando l'URL cambia
    /// restando su questa pagina — avanti, indietro, un'altra targa — si allinea la vista.
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        var targaParam = TargaDaUrl;
        if (targaParam == lastTargaParam)
        {
            return;
        }

        lastTargaParam = targaParam;
        if (targaParam is null)
        {
            // Tornati alla lista
            interventi.Clear();
            auto = null;
            hasSearched = false;
            showSearchButton = true;
            searchTarga = string.Empty;
            currentTarga = string.Empty;
        }
        else
        {
            searchTarga = targaParam;
            await SearchInterventi();
        }
    }

    private async Task TogglePagato(InterventoDto intervento)
    {
        togglingId = intervento.Id;

        try
        {
            var aggiornato = await InterventiService.SetPagatoAsync(intervento.Id, !intervento.Pagato);
            if (aggiornato is null)
            {
                _ = ShowToastAsync("Aggiornamento non riuscito. Riprova.");
                return;
            }

            var indice = interventi.FindIndex(i => i.Id == intervento.Id);
            if (indice >= 0)
            {
                interventi[indice] = aggiornato;
            }

            _ = ShowToastAsync(aggiornato.Pagato ? "Segnato come pagato" : "Segnato come da pagare");
        }
        finally
        {
            togglingId = null;
        }
    }

    private async Task ShowToastAsync(string message)
    {
        toastCts?.Cancel();
        toastCts = new CancellationTokenSource();
        var token = toastCts.Token;

        toast = message;
        await InvokeAsync(StateHasChanged);

        try
        {
            await Task.Delay(ToastDuration, token);
            toast = null;
            await InvokeAsync(StateHasChanged);
        }
        catch (TaskCanceledException)
        {
            // Sostituito da un messaggio più recente
        }
    }

    public void Dispose()
    {
        toastCts?.Cancel();
        toastCts?.Dispose();
    }

    private void OnSearchInputChanged()
    {
        // When input changes, clear results and show search button
        if (hasSearched)
        {
            interventi.Clear();
            auto = null;
            hasSearched = false;
            showSearchButton = true;
        }
    }

    private async Task HandleSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await AvviaRicerca();
        }
    }

    /// <summary>
    /// Invio o "Cerca": apre una targa passando dall'URL, così la lista resta nella cronologia
    /// e "indietro" (browser, Android) ci torna. Quale targa: quella esatta se è in archivio;
    /// l'unica voce che risponde al testo (anche per proprietario o modello) se è una sola;
    /// il testo stesso come targa nuova se non risponde nessuno. Con più voci non si sceglie
    /// al posto dell'utente: la lista resta e glielo si dice.
    /// </summary>
    private async Task AvviaRicerca()
    {
        var targa = TargaNormalizer.Normalize(searchTarga);
        if (targa.Length == 0)
        {
            return;
        }

        var voci = RicercaArchivio.Cerca(riepilogoTarghe, autoArchivio, searchTarga);
        var destinazione = voci.Any(v => v.Targa == targa) ? targa
            : voci.Count == 1 ? voci[0].Targa
            : voci.Count == 0 ? targa
            : null;

        if (destinazione is null)
        {
            _ = ShowToastAsync($"{voci.Count} risultati: scegli dalla lista");
            return;
        }

        if (destinazione == lastTargaParam)
        {
            await SearchInterventi();
            return;
        }

        Navigation.NavigateTo(UrlTarga(destinazione));
    }

    private static string UrlTarga(string targa) => $"/dashboard?targa={Uri.EscapeDataString(targa)}";

    private async Task SearchInterventi()
    {
        if (string.IsNullOrWhiteSpace(searchTarga))
        {
            return;
        }

        isSearching = true;
        currentTarga = TargaNormalizer.Normalize(searchTarga);
        searchTarga = currentTarga;
        
        try
        {
            var interventiTask = InterventiService.GetByTargaAsync(currentTarga);
            var autoTask = AutoService.GetByTargaAsync(currentTarga);
            await Task.WhenAll(interventiTask, autoTask);

            interventi = interventiTask.Result.ToList();
            auto = autoTask.Result;
            hasSearched = true;
            
            // Hide search button only if results were found
            showSearchButton = interventi.Count == 0;
        }
        finally
        {
            isSearching = false;
        }
    }

    private void NavigateToNuovoIntervento()
    {
        Navigation.NavigateTo($"/intervento/nuovo?targa={Uri.EscapeDataString(currentTarga)}");
    }

    private void NavigateToEditIntervento(Guid interventoId)
    {
        Navigation.NavigateTo($"/intervento/modifica/{interventoId}");
    }

    private void NavigateToNuovaAuto()
    {
        Navigation.NavigateTo($"/auto/nuova?targa={Uri.EscapeDataString(currentTarga)}");
    }

    private void NavigateToEditAuto()
    {
        if (auto is not null)
        {
            Navigation.NavigateTo($"/auto/modifica/{auto.Id}");
        }
    }
}

<style>
    .loading-container {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 50vh;
    }

    .loading-spinner {
        width: 2.5rem;
        height: 2.5rem;
        border: 3px solid var(--color-surface);
        border-top-color: var(--color-accent);
        border-radius: 50%;
        animation: spin 1s linear infinite;
    }

    .btn-spinner {
        width: 1.5rem;
        height: 1.5rem;
        border: 2px solid transparent;
        border-top-color: currentColor;
        border-radius: 50%;
        animation: spin 1s linear infinite;
    }

    @@keyframes spin {
        to { transform: rotate(360deg); }
    }

    .dashboard {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        min-height: calc(100vh - var(--header-height) - 4rem);
       /*  padding: 1rem; */
    }

    /* Search Section - Oversized for big hands */
    .search-section {
        padding: 1rem 0;
    }

    .search-container {
        display: flex;
        gap: 1rem;
        align-items: stretch;
    }

    .search-input {
        flex: 1;
        min-width: 0;
        padding: 1.25rem 1.5rem;
        font-size: 1.25rem;
        border: 2px solid var(--color-primary);
        border-radius: 0.75rem;
        background-color: var(--color-surface);
        color: var(--color-text);
        text-transform: uppercase;
    }

    .search-input::placeholder {
        text-transform: none;
        color: var(--color-text-muted);
    }

    .search-input:focus {
        outline: none;
        border-color: var(--color-accent);
    }

