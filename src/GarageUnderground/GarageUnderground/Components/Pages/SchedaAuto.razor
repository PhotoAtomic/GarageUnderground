@page "/auto/nuova"
@page "/auto/modifica/{Id:guid}"
@using GarageUnderground.Authentication.Client
@using GarageUnderground.Models
@using GarageUnderground.Services.Client
@inject ApiAuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject IAutoService AutoService
@rendermode InteractiveServer

<PageTitle>@(IsEditMode ? "Modifica" : "Nuova") Auto - GarageUnderground</PageTitle>

@if (isLoading)
{
    <div class="loading-container">
        <div class="loading-spinner"></div>
    </div>
}
else if (user?.IsAuthenticated == true)
{
    <section class="scheda-auto-page">
        <header class="page-header">
            <button class="btn btn-back" @onclick="NavigateBack">
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M19 12H5"/>
                    <polyline points="12 19 5 12 12 5"/>
                </svg>
                <span>Indietro</span>
            </button>
            <h1>@(IsEditMode ? "Modifica" : "Nuova") Auto</h1>
        </header>

        <div class="form-container">
            <div class="header-info">
                <div class="info-row targa-row">
                    <label>Targa</label>
                    <span class="targa-display">@targa</span>
                </div>
            </div>

            <div class="field-row">
                <div class="form-group">
                    <label for="marca">Marca</label>
                    <input type="text" id="marca" class="form-input" placeholder="Es. Fiat" @bind="marca" maxlength="@AutoValidator.TestoMaxLength" />
                </div>
                <div class="form-group">
                    <label for="modello">Modello</label>
                    <input type="text" id="modello" class="form-input" placeholder="Es. Panda" @bind="modello" maxlength="@AutoValidator.TestoMaxLength" />
                </div>
            </div>

            <div class="field-row">
                <div class="form-group">
                    <label for="anno">Anno</label>
                    <input type="number" id="anno" class="form-input" placeholder="Es. 2015" min="@AutoValidator.AnnoMinimo" max="@(DateTime.Today.Year + 1)" @bind="anno" />
                </div>
                <div class="form-group">
                    <label for="colore">Colore</label>
                    <input type="text" id="colore" class="form-input" placeholder="Es. Grigio" @bind="colore" maxlength="@AutoValidator.TestoMaxLength" />
                </div>
            </div>

            <div class="field-row">
                <div class="form-group">
                    <label for="cilindrata">Cilindrata (cc)</label>
                    <input type="number" id="cilindrata" class="form-input" placeholder="Es. 1200" min="1" step="1" @bind="cilindrata" />
                </div>
                <div class="form-group">
                    <label for="alimentazione">Alimentazione</label>
                    <select id="alimentazione" class="form-input select-input" @bind="alimentazione">
                        <option value="">—</option>
                        @foreach (var tipo in Alimentazioni.Tutte)
                        {
                            <option value="@tipo">@tipo</option>
                        }
                    </select>
                </div>
            </div>

            <div class="field-row">
                <div class="form-group">
                    <label for="proprietario">Proprietario</label>
                    <input type="text" id="proprietario" class="form-input" placeholder="Nome e cognome" @bind="proprietario" maxlength="@AutoValidator.TestoMaxLength" />
                </div>
                <div class="form-group">
                    <label for="telefono">Telefono</label>
                    <input type="tel" id="telefono" class="form-input" placeholder="Es. 333 1234567" @bind="telefono" maxlength="@AutoValidator.TestoMaxLength" />
                </div>
            </div>

            <div class="form-group">
                <label for="note">Note</label>
                <textarea id="note" class="form-input textarea-input" placeholder="Altre informazioni utili..." @bind="note" rows="3" maxlength="@AutoValidator.NoteMaxLength"></textarea>
            </div>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="error-message">
                    @errorMessage
                </div>
            }

            <div class="form-actions">
                <button class="btn btn-save" @onclick="SaveAuto" disabled="@(isSaving || isDeleting)">
                    @if (isSaving)
                    {
                        <span class="btn-spinner"></span>
                        <span>Salvataggio...</span>
                    }
                    else
                    {
                        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/>
                            <polyline points="17 21 17 13 7 13 7 21"/>
                            <polyline points="7 3 7 8 15 8"/>
                        </svg>
                        <span>@(IsEditMode ? "Salva Modifiche" : "Salva Auto")</span>
                    }
                </button>

                <div class="secondary-actions">
                    <button class="btn btn-cancel" @onclick="NavigateBack" disabled="@(isSaving || isDeleting)">
                        Annulla
                    </button>
                    @if (IsEditMode)
                    {
                        <button class="btn btn-delete" @onclick="ShowDeleteConfirmation" disabled="@(isSaving || isDeleting)">
                            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="3 6 5 6 21 6"/>
                                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                                <line x1="10" y1="11" x2="10" y2="17"/>
                                <line x1="14" y1="11" x2="14" y2="17"/>
                            </svg>
                            <span>Elimina</span>
                        </button>
                    }
                </div>
            </div>
        </div>
    </section>

    @if (showDeleteConfirmation)
    {
        <div class="modal-overlay" @onclick="HideDeleteConfirmation">
            <div class="modal-content" @onclick:stopPropagation="true">
                <div class="modal-header">
                    <svg class="modal-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"/>
                        <line x1="12" y1="8" x2="12" y2="12"/>
                        <line x1="12" y1="16" x2="12.01" y2="16"/>
                    </svg>
                    <h2>Conferma Eliminazione</h2>
                </div>
                <p class="modal-message">
                    Vuoi eliminare la scheda dell'auto <strong>@targa</strong>?<br/>
                    Gli interventi registrati non vengono toccati.
                </p>
                <div class="modal-actions">
                    <button class="btn btn-cancel-modal" @onclick="HideDeleteConfirmation" disabled="@isDeleting">
                        Annulla
                    </button>
                    <button class="btn btn-confirm-delete" @onclick="DeleteAuto" disabled="@isDeleting">
                        @if (isDeleting)
                        {
                            <span class="btn-spinner"></span>
                            <span>Eliminazione...</span>
                        }
                        else
                        {
                            <span>Elimina Scheda</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    }
}

@code {
    [Parameter]
    public Guid? Id { get; set; }

    [SupplyParameterFromQuery]
    public string? Targa { get; set; }

    private bool IsEditMode => Id.HasValue;

    private UserInfo? user;
    private bool isLoading = true;
    private bool isSaving;
    private bool isDeleting;
    private bool showDeleteConfirmation;
    private string targa = string.Empty;
    private string? marca;
    private string? modello;
    private int? anno;
    private string? colore;
    private int? cilindrata;
    private string? alimentazione;
    private string? proprietario;
    private string? telefono;
    private string? note;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        user = await AuthStateProvider.GetCurrentUserAsync(forceRefresh: true);

        if (user?.IsAuthenticated != true)
        {
            Navigation.NavigateTo("/");
            return;
        }

        if (IsEditMode)
        {
            await LoadAutoAsync();
        }
        else
        {
            targa = TargaNormalizer.Normalize(Targa);

            if (targa.Length == 0)
            {
                Navigation.NavigateTo("/dashboard");
                return;
            }

            // Se la scheda esiste già, si passa direttamente alla modifica
            var esistente = await AutoService.GetByTargaAsync(targa);
            if (esistente is not null)
            {
                Navigation.NavigateTo($"/auto/modifica/{esistente.Id}", replace: true);
                return;
            }
        }

        isLoading = false;
    }

    private async Task LoadAutoAsync()
    {
        var auto = await AutoService.GetByIdAsync(Id!.Value);

        if (auto is null)
        {
            Navigation.NavigateTo("/dashboard");
            return;
        }

        targa = auto.Targa;
        marca = auto.Marca;
        modello = auto.Modello;
        anno = auto.Anno;
        colore = auto.Colore;
        cilindrata = auto.Cilindrata;
        alimentazione = auto.Alimentazione;
        proprietario = auto.Proprietario;
        telefono = auto.Telefono;
        note = auto.Note;
    }

    private SalvaAutoDto BuildDto() => new()
    {
        Targa = targa,
        Marca = marca,
        Modello = modello,
        Anno = anno,
        Colore = colore,
        Cilindrata = cilindrata,
        Alimentazione = string.IsNullOrEmpty(alimentazione) ? null : alimentazione,
        Proprietario = proprietario,
        Telefono = telefono,
        Note = note
    };

    private async Task SaveAuto()
    {
        var dto = BuildDto();

        errorMessage = AutoValidator.Validate(dto);
        if (errorMessage is not null)
        {
            return;
        }

        isSaving = true;

        try
        {
            var result = IsEditMode
                ? await AutoService.UpdateAsync(Id!.Value, dto)
                : await AutoService.CreateAsync(dto);

            if (result is not null)
            {
                NavigateBack();
            }
            else
            {
                errorMessage = "Errore durante il salvataggio. Riprova.";
            }
        }
        catch (Exception)
        {
            errorMessage = "Errore durante il salvataggio. Riprova.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void ShowDeleteConfirmation() => showDeleteConfirmation = true;

    private void HideDeleteConfirmation() => showDeleteConfirmation = false;

    private async Task DeleteAuto()
    {
        isDeleting = true;
        errorMessage = null;

        try
        {
            if (await AutoService.DeleteAsync(Id!.Value))
            {
                NavigateBack();
            }
            else
            {
                showDeleteConfirmation = false;
                errorMessage = "Errore durante l'eliminazione. Riprova.";
            }
        }
        catch (Exception)
        {
            showDeleteConfirmation = false;
            errorMessage = "Errore durante l'eliminazione. Riprova.";
        }
        finally
        {
            isDeleting = false;
        }
    }

    private void NavigateBack()
    {
        Navigation.NavigateTo($"/dashboard?targa={Uri.EscapeDataString(targa)}");
    }
}

<style>
    .loading-container {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 50vh;
    }

    .loading-spinner {
        width: 2.5rem;
        height: 2.5rem;
        border: 3px solid var(--color-surface);
        border-top-color: var(--color-accent);
        border-radius: 50%;
        animation: spin 1s linear infinite;
    }

    .btn-spinner {
        width: 1.5rem;
        height: 1.5rem;
        border: 2px solid transparent;
        border-top-color: currentColor;
        border-radius: 50%;
        animation: spin 1s linear infinite;
    }

    @@keyframes spin {
        to { transform: rotate(360deg); }
    }

    .scheda-auto-page {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        max-width: 800px;
        margin: 0 auto;
    }

    .page-header {
        display: flex;
        align-items: center;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .page-header h1 {
        font-size: clamp(1.5rem, 4vw, 2rem);
        font-weight: 600;
        color: var(--color-text);
        margin: 0;
    }

    .btn-back {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 1rem 1.5rem;
        font-size: 1.1rem;
        font-weight: 500;
        background-color: var(--color-surface);
        color: var(--color-text);
        border: 2px solid var(--color-primary);
        border-radius: 0.75rem;
        cursor: pointer;
        transition: background-color 0.2s, transform 0.1s;
        min-height: 56px;
    }

    .btn-back:hover {
        background-color: var(--color-primary);
    }

    .btn-back:active {
        transform: scale(0.98);
    }

    .form-container {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        background-color: var(--color-surface);
        padding: 1rem;
        border-radius: 1rem;
    }

    .header-info {
        display: flex;
        flex-wrap: wrap;
        gap: 1.5rem;
        padding-bottom: 1.5rem;
        border-bottom: 2px solid var(--color-primary);
        align-items: flex-end;
    }

    .info-row {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .targa-row {
        flex: 1;
        min-width: 150px;
    }

    .info-row label {
        font-size: 1rem;
        font-weight: 500;
        color: var(--color-text-muted);
    }

    .targa-display {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--color-info);
        padding: 0.75rem 1.25rem;
        background-color: var(--color-bg);
        border-radius: 0.5rem;
        letter-spacing: 0.1em;
        min-height: 60px;
        display: flex;
        align-items: center;
    }

    .field-row {
        display: flex;
        flex-wrap: wrap;
        gap: 1.5rem;
    }

    .field-row .form-group {
        flex: 1;
        min-width: 200px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .form-group label {
        font-size: 1.1rem;
        font-weight: 500;
        color: var(--color-text);
    }

    .form-input {
        padding: 1.25rem 1.5rem;
        font-size: 1.25rem;
        border: 2px solid var(--color-primary);
        border-radius: 0.75rem;
        background-color: var(--color-bg);
        color: var(--color-text);
        font-family: inherit;
        min-height: 60px;
        width: 100%;
    }

    .form-input::placeholder {
        color: var(--color-text-muted);
    }

    .form-input:focus {
        outline: none;
        border-color: var(--color-info);
    }

    .select-input {
        color-scheme: dark;
        cursor: pointer;
    }

    .textarea-input {
        resize: vertical;
        min-height: 120px;
        line-height: 1.5;
    }

    .error-message {
        padding: 1rem 1.5rem;
        background-color: rgba(233, 69, 96, 0.2);
        border: 2px solid var(--color-accent);
        border-radius: 0.75rem;
        color: var(--color-accent);
        font-size: 1.1rem;
        font-weight: 500;
    }

    .form-actions {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        margin-top: 1rem;
    }

    .secondary-actions {
        display: flex;
        gap: 1rem;
    }

    .btn {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 1.25rem 1rem;
        font-size: 1.25rem;
        font-weight: 600;
        border: none;
        border-radius: 0.75rem;
        cursor: pointer;
        transition: background-color 0.2s, transform 0.1s;
        min-height: 64px;
    }

    .btn:active:not(:disabled) {
        transform: scale(0.98);
    }

    .btn:disabled {
        opacity: 0.7;
        cursor: not-allowed;
    }

    .btn-save {
        background-color: #26b050;
        color: white;
        width: 100%;
    }

    .btn-save:hover:not(:disabled) {
        background-color: #1e9040;
    }

    .btn-cancel {
        background-color: var(--color-bg);
        color: var(--color-text);
        border: 2px solid var(--color-primary);
        flex: 1;
    }

    .btn-cancel:hover:not(:disabled) {
        background-color: var(--color-primary);
    }

    .btn-delete {
        background-color: transparent;
        color: var(--color-accent);
        border: 2px solid var(--color-accent);
        flex: 1;
    }

    .btn-delete:hover:not(:disabled) {
        background-color: var(--color-accent);
        color: white;
    }

    .icon {
        width: 1.5rem;
        height: 1.5rem;
        flex-shrink: 0;
    }

    @@media (min-width: 600px) {
        .form-actions {
            flex-direction: row;
            flex-wrap: wrap;
        }

        .btn-save {
            flex: 1;
            min-width: 200px;
        }

        .secondary-actions {
            flex: 1;
            min-width: 200px;
        }
    }

    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-color: rgba(0, 0, 0, 0.7);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1rem;
        z-index: 1000;
        animation: fadeIn 0.2s ease-out;
    }

    @@keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    .modal-content {
        background-color: var(--color-surface);
        border-radius: 1rem;
        padding: 2rem;
        max-width: 500px;
        width: 100%;
        animation: slideUp 0.2s ease-out;
    }

    @@keyframes slideUp {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .modal-header {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1.5rem;
    }

    .modal-icon {
        width: 3rem;
        height: 3rem;
        stroke: var(--color-accent);
        flex-shrink: 0;
    }

    .modal-header h2 {
        font-size: 1.5rem;
        font-weight: 600;
        color: var(--color-text);
        margin: 0;
    }

    .modal-message {
        font-size: 1.1rem;
        color: var(--color-text);
        line-height: 1.6;
        margin: 0 0 2rem;
    }

    .modal-message strong {
        color: var(--color-info);
    }

    .modal-actions {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .btn-cancel-modal {
        background-color: var(--color-bg);
        color: var(--color-text);
        border: 2px solid var(--color-primary);
        flex: 1;
    }

    .btn-cancel-modal:hover:not(:disabled) {
        background-color: var(--color-primary);
    }

    .btn-confirm-delete {
        background-color: var(--color-accent);
        color: white;
        flex: 1;
    }

    .btn-confirm-delete:hover:not(:disabled) {
        background-color: #d13550;
    }
</style>
